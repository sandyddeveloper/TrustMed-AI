# ==========================================
# TrustMed-AI Backend Environment Variables
# ==========================================

# Application Settings
APP_NAME="TrustMed-AI Backend"
APP_ENV=development
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-key-change-this-in-production-use-openssl-rand-hex-32"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# CORS Settings (JSON Array of strings or comma-separated)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=trustmed_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trustmed_db

# Web3 & Blockchain
WEB3_PROVIDER_URI=https://eth-sepolia.g.alchemy.com/v2/demo
WEB3_CHAIN_ID=11155111
WEB3_CONTRACT_ADDRESS=""
WEB3_PRIVATE_KEY=""

# IPFS Configuration
IPFS_GATEWAY=https://ipfs.io/ipfs/
IPFS_API_URL=http://localhost:5001/api/v0

# Explainable AI (XAI) Settings
XAI_DEFAULT_METHOD=shap
XAI_NUM_BACKGROUND_SAMPLES=100
