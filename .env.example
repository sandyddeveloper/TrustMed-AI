# ==========================================
# TrustMed-AI Root Environment Variables
# ==========================================

# Application Settings
APP_NAME="TrustMed-AI"
APP_ENV=production
DEBUG=False
API_V1_STR="/api/v1"
SECRET_KEY="generate-a-strong-random-secret-key-for-production"

# PostgreSQL Database (Used by docker-compose)
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_change_me
POSTGRES_DB=trustmed_db
DATABASE_URL=postgresql://postgres:postgres_secure_password_change_me@db:5432/trustmed_db

# Web3 & Blockchain
WEB3_PROVIDER_URI=https://eth-sepolia.g.alchemy.com/v2/your-api-key
WEB3_CHAIN_ID=11155111
WEB3_CONTRACT_ADDRESS=""
WEB3_PRIVATE_KEY=""

# IPFS Configuration
IPFS_GATEWAY=https://ipfs.io/ipfs/
IPFS_API_URL=http://ipfs:5001/api/v0

# Google Gemini AI Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
